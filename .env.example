# Copy this file to .env (gitignored) and fill in machine-specific or secret
# values. Anything in configs/default.yaml can also be overridden here using
# the WEBCAM_TRACKER_<SECTION>__<FIELD> convention explained in that file.
#
#   cp .env.example .env

# Example: use webcam index 1 instead of the default 0
# WEBCAM_TRACKER_VIDEO__SOURCE=1

# Example: verbose logging while debugging
# WEBCAM_TRACKER_LOGGING__LEVEL=DEBUG

# Stage 2 will add a database encryption key here — never commit real secrets.
